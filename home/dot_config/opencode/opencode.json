{
  "$schema": "https://opencode.ai/config.json",
  "model": "freellmapi/auto",
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true }
  },
  "plugins": ["opencode-agent-memory"],
  "providers": {
    "freellmapi": {
      "package": "@ai-sdk/openai-compatible",
      "name": "FreeLLMAPI",
      "settings": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "freellmapi-98b0fbf0f73fdb986a07dfeb6cff3bcb3eb3b599299883ed"
      },
      "models": {
        "auto": {
          "name": "Auto"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer ctx7sk-352d1f18-a64d-475c-b680-c16f19e6c559"
        }
      },
      "deepwiki": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "memory": {
        "disabled": false,
        "type": "local",
        "command": ["bunx", "-y", "@modelcontextprotocol/server-memory"]
      },
      "fetch": {
        "disabled": false,
        "type": "local",
        "command": ["uvx", "mcp-server-fetch"]
      }
    }
  }
}
