{
  "$schema": "https://opencode.ai/config.json",
  "model": "freellmapi/auto",
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true }
  },
  "plugins": ["opencode-agent-memory"],
  "provider": {
    "freellmapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeLLMAPI",
      "options": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "freellmapi-98b0fbf0f73fdb986a07dfeb6cff3bcb3eb3b599299883ed"
      },
      "models": {
        "auto": {
          "name": "Auto"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-352d1f18-a64d-475c-b680-c16f19e6c559"
      }
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": "bunx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "enabled": true
    }
  }
}