{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "none",
    "verbosity": "high",
    "image_preview": true,
    "permissions": "autoaccept",
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "mode": "on"
  },
  "debug": {
    "devtools": false
  }
}
