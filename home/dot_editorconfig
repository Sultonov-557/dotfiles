# EditorConfig — cross-editor consistency
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{js,jsx,ts,tsx,html,css,scss}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[COMMIT_EDITMSG]
indent_size = 0
trim_trailing_whitespace = false
