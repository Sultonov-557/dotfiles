#!/usr/bin/env bash
# =============================================================================
# run_onchange_install-packages.sh.tmpl
# chezmoi run_onchange script — installs packages from packages/**/*.txt using yay.
# Re-runs whenever any package file in packages/ or its subdirectories changes.
#
# Packages hash:
{{- range glob (print .chezmoi.workingTree "/packages/**/*.txt") | sortAlpha }}
#   {{ . | trimPrefix (print $.chezmoi.workingTree "/packages/") }}: {{ include . | sha256sum }}
{{- end }}
# =============================================================================
set -euo pipefail

PACKAGES_DIR="{{ .chezmoi.workingTree }}/packages"

if [ ! -d "$PACKAGES_DIR" ]; then
  echo ":: packages/ directory not found at $PACKAGES_DIR, skipping..."
  exit 0
fi

# ── Ensure yay is installed ───────────────────────────────────────────────────
if ! command -v yay &>/dev/null; then
  echo ":: yay not found. Installing yay..."
  if pacman -Si yay &>/dev/null; then
    sudo pacman -S --needed --noconfirm yay
  else
    sudo pacman -S --needed --noconfirm base-devel git
    BUILD_DIR=$(mktemp -d)
    git clone https://aur.archlinux.org/yay-bin.git "$BUILD_DIR/yay-bin" || \
      git clone https://aur.archlinux.org/yay.git "$BUILD_DIR/yay-bin"
    (cd "$BUILD_DIR/yay-bin" && makepkg -si --noconfirm)
    rm -rf "$BUILD_DIR"
  fi
  echo ":: yay installed successfully."
fi

# ── Collect all packages recursively ──────────────────────────────────────────
ALL_PKGS=()

while IFS= read -r -d '' pkg_file; do
  while IFS= read -r line || [ -n "$line" ]; do
    # Trim whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    # Skip comments and empty lines
    [[ -z "$line" ]] || [[ "$line" == \#* ]] && continue

    # Strip inline comments
    line="${line%%#*}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue

    ALL_PKGS+=("$line")
  done < "$pkg_file"
done < <(find "$PACKAGES_DIR" -type f -name "*.txt" -print0 | sort -z)

if [ ${#ALL_PKGS[@]} -eq 0 ]; then
  echo ":: No packages found in $PACKAGES_DIR"
  exit 0
fi

echo ":: Installing ${#ALL_PKGS[@]} packages across categories via yay..."
yay -S --needed --noconfirm "${ALL_PKGS[@]}"

echo ":: Package installation complete!"
