#!/usr/bin/env bash
# =============================================================================
# caffeine — Prevent idle/suspend
# =============================================================================
# Toggle: stop hypridle while active, restart it when done
# Depends: hypridle, notify-send
set -euo pipefail

FLAGFILE="/tmp/caffeine"

if [ -f "$FLAGFILE" ]; then
  rm -f "$FLAGFILE"
  killall hypridle 2>/dev/null || true
  hypridle &
  notify-send "Caffeine" "Off — idle enabled" -t 2000
else
  touch "$FLAGFILE"
  killall hypridle 2>/dev/null || true
  notify-send "Caffeine" "On — idle disabled" -t 2000
fi
