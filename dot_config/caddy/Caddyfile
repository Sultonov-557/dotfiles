# =============================================================================
# Caddyfile — User-level Caddy config
# Managed by chezmoi
# =============================================================================
# Run: caddy run --config ~/.config/caddy/Caddyfile
# Or enable: systemctl --user enable --now caddy
#
# glance.home / adguard.home resolve via AdGuardHome DNS rewrites
# (dot_config/AdGuardHome/AdGuardHome.yaml) to 127.0.0.1 — this machine only,
# by design; Caddy itself still binds 0.0.0.0 so LAN access works if you
# later repoint those rewrites at this machine's LAN IP instead.
#
# `tls internal`, not Caddy's normal automatic HTTPS: these are internal-only
# fake-TLD names, so Let's Encrypt can't issue a cert for them (no public DNS,
# no HTTP-01 challenge reachable) — it would just retry and fail. `tls
# internal` uses Caddy's own local CA instead, no ACME involved. Bare
# hostname (no http://) also gets you the automatic http->https redirect on
# port 80 for free.
#
# Browsers will show an untrusted-cert warning until Caddy's local CA is
# trusted on this machine: run `caddy trust` once (needs sudo — see
# run_once_after_setup-caddy-glance.sh). Any OTHER device hitting these
# domains (phone, another PC) needs that same CA installed manually — the
# root cert Caddy generates lives at
# ~/.local/share/caddy/pki/authorities/local/root.crt, copy that over.
#
# Binding ports 80 and 443 needs CAP_NET_BIND_SERVICE on the caddy binary
# (this is a user-level service, not root) — see run_once_after_setup-caddy-glance.sh.

glance.home {
	tls internal
	reverse_proxy localhost:7477
}

adguard.home {
	tls internal
	reverse_proxy localhost:9000
}
